MODE=dev
DOCREVIEW_LOCAL_HOST=127.0.0.1
DB_PORT=5432
APP_PORT=8000
DOCREVIEW_OPERATOR_WEB_PORT=3000
DOCREVIEW_OPERATOR_PORT=18001
DOCREVIEW_TUNNEL_PORT=18000
DOCREVIEW_ORIGIN_PORT=8000
DOCREVIEW_HTTP_PORT=80
DOCREVIEW_HTTPS_PORT=443

SEC_USER_AGENT=Jane Doe jane@example.com
DART_API_KEY=<your-dart-key>
# OPENAI_API_KEY wins when set. Otherwise MODE=dev reads OPENAI_API_KEY_LOCAL and
# MODE=prod reads OPENAI_API_KEY_PROD, so dev and prod can keep separate project keys.
OPENAI_API_KEY=<your-openai-key>
OPENAI_API_KEY_LOCAL=<your-dev-openai-key>
OPENAI_API_KEY_PROD=<your-prod-openai-key>
EMBEDDING_MODEL=text-embedding-3-large
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=<your-local-model>
LOCAL_LLM_PROTOCOL=auto
