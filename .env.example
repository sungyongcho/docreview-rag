# Copy to .env. Setup and execution commands are in README.md.
SEC_USER_AGENT=Jane Doe jane@example.com
DART_API_KEY=<your-dart-key>
# rag-dev and rag-prod select only their own key slot.
OPENAI_API_KEY_LOCAL=<your-dev-openai-key>
OPENAI_API_KEY_PROD=<your-prod-openai-key>

# Optional host ports.
# DB_PORT=5432
# APP_PORT=8000

# Optional initial server URL. Settings saves take priority; models are discovered.
# Compose defaults to this URL; a directly run host app defaults to 127.0.0.1:11434.
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
