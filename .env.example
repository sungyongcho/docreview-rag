# Copy to .env. Setup and execution commands are in README.md.

# ============================================================
# Accounts and API keys
# ============================================================
SEC_USER_AGENT=Jane Doe jane@example.com
DART_API_KEY=<your-dart-key>
# rag-dev and rag-prod select only their own key slot.
OPENAI_API_KEY_LOCAL=<your-dev-openai-key>
OPENAI_API_KEY_PROD=<your-prod-openai-key>

# ============================================================
# Local services
# ============================================================
# Host ports.
DB_PORT=5432
# APP_PORT=8000

# Embeddings. The local default uses OpenAI at 384 dimensions.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# Optional local model server; choose the model in the web UI.
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LOCAL_LLM_PROTOCOL=auto

# ============================================================
# Deployment (GCP single e2-medium origin)
# ============================================================
# Prerequisite: an authenticated gcloud CLI (gcloud auth login <account>).
# One-shot entry point: deploy/gcp/deploy_all.sh vm|backend|origin|all
# DocReview owns the VM, the firewall rule (docreview-allow-cloudflare-<port>)
# and the network tag (docreview-origin).
#
# DEPLOY_GCP_PROJECT - required. Same GCP project as the gomoku deployment.
DEPLOY_GCP_PROJECT=
# DEPLOY_GCP_ZONE - optional. Default us-central1-a.
DEPLOY_GCP_ZONE=us-central1-a
# DEPLOY_VM_NAME - optional. Default docreview-rag-agent.
DEPLOY_VM_NAME=docreview-rag-agent
# DEPLOY_MACHINE_TYPE - optional. Default e2-medium (2 vCPU, 4 GB RAM).
DEPLOY_MACHINE_TYPE=e2-medium
# DEPLOY_BOOT_DISK_SIZE - optional. Default 30GB pd-standard.
# DEPLOY_BOOT_DISK_SIZE=30GB
# DEPLOY_ORIGIN_PORT - optional. Host port Caddy publishes (default 8000).
# DEPLOY_ORIGIN_PORT=8000
# DEPLOY_ARTIFACT_DIR - required for first-install. Validated restore artifacts.
# DEPLOY_ARTIFACT_DIR=~/.local/share/docreview/prod-artifacts/<release>
# FIREBASE_SITE - optional. Firebase Hosting site id; defaults to deploy/firebase/.firebaserc.
# FIREBASE_SITE=
#
# Values that live elsewhere:
# - OPENAI_API_KEY_PROD (above) is copied to the VM as the production key.
# - DOCREVIEW_IMAGE and POSTGRES_PASSWORD live in the gitignored
#   deploy/gcp/backend.env; copy deploy/gcp/backend.env.example and fill both.
#   DOCREVIEW_IMAGE must be an image pushed to Artifact Registry that the VM can pull.
# - The Cloudflare Worker/DNS handoff values (DEPLOY_DOCREVIEW_IP,
#   DEPLOY_DOCREVIEW_ORIGIN, DEPLOY_DOCREVIEW_SITE_ORIGIN) belong in the gomoku
#   .env; deploy/gcp/deploy_all.sh origin prints them after the VM is up.
