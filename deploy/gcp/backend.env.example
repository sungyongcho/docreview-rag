# Copy to deploy/gcp/backend.env (gitignored). deploy_backend.sh copies it to the VM
# as /opt/docreview/.env; docker compose substitutes ${VAR} from it.
#
# GCP-side values (DEPLOY_GCP_PROJECT, DEPLOY_GCP_ZONE, DEPLOY_VM_NAME,
# DEPLOY_MACHINE_TYPE) live in the repo-root .env; see deploy_env_config.sh.

# Image built and pushed by you; the Always Free VM only pulls it.
DOCREVIEW_IMAGE=us-central1-docker.pkg.dev/YOUR_PROJECT/YOUR_REPOSITORY/docreview:latest

# deploy_backend.sh writes this value to POSTGRES_PASSWORD_FILE on the VM.
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_PASSWORD_FILE=/var/lib/docreview/secrets/postgres_password

# Server-side OpenAI key. Spend is capped by DOCREVIEW_PUBLIC_DAILY_COST_USD in
# docker-compose.deploy.yml.
OPENAI_API_KEY_PROD=replace-with-server-key

# Optional. Host port Caddy publishes for the Cloudflare Worker (default 8000) and the
# loopback-only operator port that bypasses Caddy for the SSH tunnel (default 8001).
# DOCREVIEW_ORIGIN_PORT=8000
# DOCREVIEW_OPERATOR_PORT=8001
