# Keep the build context and image to what the container actually runs: the app tree,
# the locked dependency metadata, and the corpus data/ingest reads.
.git
.venv
.env
.dashboard
.dashboard-cache
.claude
tests
docs/*
!docs/DEVELOPMENT_STORY.en.md
!docs/DEVELOPMENT_STORY.ko.md
!docs/TUTORIAL/
docs/TUTORIAL/*
!docs/TUTORIAL/ko/
!docs/TUTORIAL/en/
!docs/TUTORIAL/assets/
# The web build reads the capture plan to validate placements and copy accepted screenshots.
!docs/TUTORIAL/capture-plan.json
data/eval_runs
data/corpus
data/runtime
data/local-prod
data/prod-embedding-budget.json
data/local-settings
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
web/node_modules
web/.next
web/out
deploy/firebase/public

web/public/tutorial-assets

# Never bundle custom local presets into a deployment image.
data/presets/*.json
!data/presets/balanced.json
!data/presets/korean.json
!data/presets/accuracy.json
