# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Environment and secrets
.env
.env.*
!.env.example

# Caches and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
web/node_modules/
web/.next/
web/next-env.d.ts
web/out/
web/*.tsbuildinfo
deploy/firebase/public/
deploy/firebase/.firebase/
*.egg-info/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/

# Runtime artifacts
logs/
*.log
tmp/
data/eval_runs/
data/local-settings/

# Raw corpus filings are reproducible from each registry's manifest and downloader.
# The manifests sit directly in data/corpus/ and match none of these patterns, so no
# negation is needed to keep them tracked.
data/corpus/**/*.html
data/corpus/**/*.xml
data/corpus/**/*.zip

# Local or licensed source material is not part of the public portfolio.
old/
42_curriculum/

# Dashboard cache written by .dashboard/dashboard-refresh.sh.
.dashboard-cache/

# Generated from the tutorial Markdown image references.
web/public/tutorial-assets/
web/.tutorial/

# Runtime acquisition scopes for parsing only downloaded reports.
data/corpus/acquired-*-manifest.json

# Custom DEV presets are user data; ship only canonical built-ins.
data/presets/*.json
!data/presets/balanced.json
!data/presets/korean.json
!data/presets/accuracy.json

# Emitted only after an explicitly confirmed fresh-start cleanup.
data/browser-reset.json
data/browser-reset.tmp

# Runtime locks, evaluation scopes and processing selections written by the running stack.
data/corpus/.source-lock
data/corpus/.evaluation-scope-*.json
data/corpus/selected-*-manifest.json
data/golden/.datasets.lock

# User golden revisions are local data; ship only the built-in suites.
data/golden/*.json
!data/golden/retrieval.json
!data/golden/retrieval_ko.json
!data/golden/dart_retrieval.json
!data/golden/dart_retrieval_ko.json
!data/golden/sec_en_v2_astra.json
!data/golden/sec_ko_v2_astra.json
!data/golden/sec_mixed_v2_astra.json

# Retired deploy env path kept ignored so an existing secrets file is never committed.
deploy/gcp/backend.env
# User-specific Firebase site selection; keep only the example.
deploy/firebase/.firebaserc

# Persistent public OpenAI allowance; private runtime state, never source data.
/data/runtime/public-ai-limits.sqlite3*
