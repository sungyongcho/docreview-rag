#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Stamp the port map so it cannot fall behind the tree.
#
# The map's `기준` column records the commit a chunk landed on -- HEAD at the
# moment of the commit. That is knowable only here, before the commit exists,
# which is the whole reason the column replaced the chunk's own hash. Writing it
# by hand meant the row arrived a commit late, every time.
#
# This does not guess. It stamps only when the staged tree adds files under the
# landing path of the first unstamped row, and only when no stamped row shares
# that landing path -- two chunks landing in one directory make "files were
# added there" ambiguous (a review-split file would stamp the next chunk), so
# the ambiguous case prints what it would need instead of stamping.
#
# It reads and rewrites the STAGED README.md, never `git add`s the worktree
# file: a partial `git add -p` stays partial and unrelated worktree edits stay
# uncommitted. The worktree copy gets the same one-cell edit so it does not
# show as modified right after the commit.
#
# The row format here mirrors the parser in .dashboard/panel.sh (port-map
# section); change the table shape in both places or neither.
#
# Force the ambiguous case: DASH_STAMP=1 git commit ...
# Disable for one commit:  DASH_NO_STAMP=1 git commit ...
# Disable entirely:        git config --unset core.hooksPath
# ---------------------------------------------------------------------------
set -uo pipefail
[ -n "${DASH_NO_STAMP:-}" ] && exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
git ls-files --cached --error-unmatch README.md >/dev/null 2>&1 || exit 0
git show :README.md 2>/dev/null | grep -q 'port-map:start' || exit 0

# A landing cell is prose: a path, then optionally a note after an em dash.
land_path() {
    local t=${1%%—*}
    t=${t%% *}
    printf '%s' "${t%,}"
}

# One pass over the STAGED table: the first row with no base is the chunk that
# could be landing now; every stamped row's landing is kept for the ambiguity
# check below.
row_no=""; stage=""; landing=""
stamped_landings=()
while IFS=$'\t' read -r kind nr st ld; do
    case $kind in
        DONE) stamped_landings+=("$ld") ;;
        PEND) [ -z "$row_no" ] && { row_no=$nr; stage=$st; landing=$ld; } ;;
    esac
done < <(git show :README.md | awk -F'|' '
    /port-map:start/ { inside = 1; next }
    /port-map:end/   { inside = 0 }
    inside && /^\|/ {
        for (i = 2; i <= 5; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
        if ($2 == "단계" || $2 ~ /^-+$/) next
        printf "%s\t%s\t%s\t%s\n", ($5 == "—" ? "PEND" : "DONE"), NR, $2, $4
    }
')
[ -n "$row_no" ] || exit 0

target=$(land_path "$landing")
[ -n "$target" ] || exit 0

# Only files this commit adds count: a chunk arrives, it does not edit its way in.
if ! git diff --cached --name-only --diff-filter=A -- "$target" | grep -q .; then
    exit 0
fi

# A stamped row already landed on the same path: added files there no longer
# prove that THIS row's chunk arrived. Say so and stamp nothing.
if [ -z "${DASH_STAMP:-}" ]; then
    for prev in "${stamped_landings[@]}"; do
        [ "$(land_path "$prev")" = "$target" ] || continue
        printf 'port map: %s 에는 이미 스탬프된 덩이가 있어 이번 추가가 %s 덩이인지 알 수 없음 — 맞으면 DASH_STAMP=1 git commit, 아니면 그대로 두면 된다\n' \
            "$target" "$stage" >&2
        exit 0
    done
fi

base=$(git rev-parse --short HEAD 2>/dev/null) || base="루트"
mode=$(git ls-files --cached --format='%(objectmode)' README.md 2>/dev/null)
mode=${mode:-100644}

# Replace only the last cell of that row, in the staged copy, and write the
# result straight back into the index.
tmp=$(mktemp "${TMPDIR:-/tmp}/portmap.XXXXXX") || exit 0
trap 'rm -f "$tmp"' EXIT
git show :README.md | awk -v n="$row_no" -v b="$base" 'NR == n {
    sub(/\|[^|]*\|[ \t]*$/, "| " b " |")
} { print }' > "$tmp" || exit 0
hash=$(git hash-object -w -- "$tmp") || exit 0
git update-index --cacheinfo "$mode,$hash,README.md" || exit 0

# Mirror the one-cell edit into the worktree copy (matched by stage, not line
# number -- the worktree may hold unrelated edits), so the file is not
# instantly behind its own commit. Best effort; the commit itself is done.
wt="$ROOT/README.md"
if [ -f "$wt" ]; then
    awk -v st="$stage" -v b="$base" -F'|' '
        /port-map:start/ { inside = 1 }
        /port-map:end/   { inside = 0 }
        {
            if (inside && !done && $0 ~ /^\|/) {
                s = $2; e = $5
                gsub(/^[ \t]+|[ \t]+$/, "", s); gsub(/^[ \t]+|[ \t]+$/, "", e)
                if (s == st && e == "—") {
                    sub(/\|[^|]*\|[ \t]*$/, "| " b " |")
                    done = 1
                }
            }
            print
        }
    ' "$wt" > "$wt.stamp.$$" 2>/dev/null && mv "$wt.stamp.$$" "$wt"
    rm -f "$wt.stamp.$$" 2>/dev/null
fi

printf 'port map: %s 기준 %s 로 기록함 (스테이지·작업트리 README의 그 칸만 갱신)\n' "$stage" "$base" >&2
