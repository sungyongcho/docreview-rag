#!/usr/bin/env bash
# Reject a commit message that is not in the form AGENTS.md (Commits) fixes.
set -euo pipefail

fail() {
  echo "commit-msg: $1" >&2
  echo "commit-msg: write '<type>(<scope>): <outcome>', a blank line, then Summary, Changes and Verification, with no attribution line (AGENTS.md, Commits)" >&2
  exit 1
}

# Git's own comment lines are not part of the message.
message="$(grep -v '^#' "$1" || true)"
title="$(sed -n 1p <<<"$message")"
[[ "$title" =~ ^[a-z]+(\([a-z0-9._/-]+\))?!?:\ .+ ]] || fail "the title is not a Conventional Commit: $title"
[ -z "$(sed -n 2p <<<"$message")" ] || fail "the second line is not blank"

last=2
for section in Summary Changes Verification; do
  line="$(grep -n -m 1 "^$section" <<<"$message" | cut -d: -f1 || true)"
  [ -n "$line" ] || fail "the body has no $section section"
  [ "$line" -gt "$last" ] || fail "the $section section is out of order"
  last=$line
done

# A line of its own, as a tool writes it; prose may still mention the words.
if grep -q -i -E '^co-authored-by:|^[^[:alnum:]]*generated with ' <<<"$message"; then
  fail "the message carries a tool-attribution line"
fi
