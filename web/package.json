{
  "name": "docreview-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "predev": "node scripts/prepare-tutorial.mjs",
    "pretest": "node scripts/prepare-tutorial.mjs",
    "pretypecheck": "node scripts/prepare-tutorial.mjs",
    "prebuild": "node scripts/prepare-tutorial.mjs",
    "generate:api": "openapi-typescript ../schemas/api.openapi.json -o lib/api-generated.ts && openapi-typescript ../schemas/operator.openapi.json -o lib/operator-api-generated.ts",
    "check:api": "openapi-typescript ../schemas/api.openapi.json -o lib/api-generated.ts --check && openapi-typescript ../schemas/operator.openapi.json -o lib/operator-api-generated.ts --check"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
