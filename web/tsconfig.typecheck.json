{
  // `npm run typecheck` checks the sources only. Next adds its generated `.next` types to
  // tsconfig.json, and the validator that `next dev` writes imports names it does not use,
  // which `noUnusedLocals` rejects. Leaving `.next` out keeps the result independent of what
  // an earlier dev server or build left on disk.
  "extends": "./tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
