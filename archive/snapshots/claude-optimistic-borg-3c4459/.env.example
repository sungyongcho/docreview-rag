# Copy to .env. Only the keys in this first block usually need a value; everything
# else has a working default and is listed here commented out so you can see it exists.

MODE=dev

# Filing sources. EDGAR rejects requests without a contact string.
SEC_USER_AGENT=Jane Doe jane@example.com
DART_API_KEY=<your-dart-key>

# OPENAI_API_KEY wins when set. Otherwise MODE=dev reads OPENAI_API_KEY_LOCAL and
# MODE=prod reads OPENAI_API_KEY_PROD, so dev and prod can keep separate project keys.
OPENAI_API_KEY_LOCAL=<your-dev-openai-key>
OPENAI_API_KEY_PROD=<your-prod-openai-key>

# Host ports. Uncomment one only when it is already taken on this machine.
# DB_PORT=5432
# APP_PORT=8000
# DOCREVIEW_OPERATOR_WEB_PORT=3000

# Compose layers. The dev overlay adds the local model engine and the ollama service,
# so plain `docker compose up` means development. The production overlay is explicit:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d app
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Answer with a local model instead of OpenAI, leaving retrieval unchanged. Start the
# model host first, which downloads the weights once into a named volume:
#   docker compose --profile local-llm up -d ollama
#   docker compose --profile local-llm exec ollama ollama pull gemma4:e4b
# Do not append /v1 to an Ollama URL; that suffix selects the OpenAI Responses protocol.
# Ignored when MODE=prod, whatever these say.
# LOCAL_LLM_BASE_URL=http://ollama:11434
# LOCAL_LLM_MODEL=<your-local-model>
# LOCAL_LLM_TIMEOUT_S=120
# LOCAL_LLM_MAX_OUTPUT_TOKENS=600

# Remaining knobs keep their defaults and are documented where they are used:
# EMBEDDING_MODEL (app/config.py), DOCREVIEW_LOCAL_HOST and the operator, tunnel,
# origin and HTTP/HTTPS ports (scripts/local_env.py, deploy/gcp).
