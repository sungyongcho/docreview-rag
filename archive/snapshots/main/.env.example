# 복사해서 채우기:  cp .env.example .env

# --- LLM (Step 10~12: claim-check 판정 + 워커) ---
OPENAI_API_KEY=                     # 본인 OpenAI 키
PRIMARY_LLM_PROVIDER=openai         # openai=실제 판정 / mock=키 없이 결정적(가짜 응답)
LLM_MODEL=gpt-4o-mini               # 프로젝트가 접근 가능한 모델 (안 되면 models.list()로 확인)

# --- 임베딩 (Step 3~7) ---
EMBEDDING_PROVIDER=st               # st=진짜 의미검색(DB Vector(384) 필수) / fake=무과금 테스트용
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- 데이터셋 ---
DATASET_ROOT=data/sample1/docreview-dataset/data

# --- 인프라 (docker compose) ---
DATABASE_URL=postgresql+asyncpg://docreview:docreview@localhost:5432/docreview
REDIS_URL=redis://localhost:6379/0
